gradle-wrapper.jar
/.gradle
# Flutter points the modules' build dirs at the repo-root `build/`, which the
# root .gitignore covers, but Gradle still writes its own problems report into
# the root Gradle project — that is this directory.
/build/
/captures/
/gradlew
/gradlew.bat
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
# ...except this one, which is deliberately public: it signs only the
# side-by-side CI build (`dev.calyptra.pappus.ci`), never a release. See the
# `ci` signingConfig in app/build.gradle.kts for what that does and does not
# allow. The blanket rules above stay, so a real signing key still cannot be
# committed by accident.
!app/pappus-ci.jks
