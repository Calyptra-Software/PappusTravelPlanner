<?xml version="1.0" encoding="utf-8"?>
<!-- The side-by-side build's icon: the app's own mark plus a "CI" chip, so the
     two installs are told apart on the launcher. Generated by
     tool/build_ci_icon.py; the background is shared with the real icon on
     purpose, since only the provenance differs. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
      <inset
          android:drawable="@drawable/ic_launcher_ci_foreground"
          android:inset="0%" />
  </foreground>
</adaptive-icon>
