<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Needed by the online connection search (Transitous/MOTIS). The debug and
         profile manifests declare this too, but a release build uses this one, so
         without it the search can't reach the network. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The map's "you are here". Asked for at the moment the locate button is
         pressed and never at launch, and nothing the receiver answers is stored
         or sent anywhere. Both are declared because Android 12 and later let the
         user grant the coarse one from the same dialog: fine is what a map on a
         footpath needs, coarse is the user's right to say "roughly" instead, and
         a build that declares only fine offers them no such choice.
         Deliberately no ACCESS_BACKGROUND_LOCATION: the mark exists while a map
         is open, and there is no feature here that follows anyone. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Where a photograph was taken. Since Android 10 the system zeroes the
         GPS tags of a picture handed to an app without this, so a holiday photo
         attaches itself with no place and no reason given. It is **off until
         the user switches it on** in settings, which is the only moment it is
         ever requested, and the app reads nothing else out of the shared
         collection: it never enumerates a gallery (that would be
         READ_MEDIA_IMAGES, which is deliberately not here) and asks only about
         the one file the picker just handed over. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION"/>
    <!-- Four permissions this app does not want, taken back out of the merged
         manifest. androidx work-runtime declares them, and it arrives twice over:
         home_widget depends on it directly and again through
         androidx.glance:glance-appwidget. Neither can simply be excluded: three
         of home_widget's own Kotlin sources reference Glance, so the plugin would
         stop compiling, and dropping Glance would leave the direct dependency
         standing anyway.

         Nothing here ever runs a worker. WorkManager is reached only from
         HomeWidgetBackgroundWorker, which only HomeWidget.registerInteractivityCallback
         leads to, and this app uses none of that: it pushes a payload with
         saveWidgetData/updateWidget and answers a tap through a deep link. So the
         four are dead weight, and on F-Droid's listing page RECEIVE_BOOT_COMPLETED
         beside FOREGROUND_SERVICE reads as a claim about a trip planner that is
         simply not true.

         The trade is stated rather than hidden. Adding an interactivity callback
         later means putting these back, and the failure would be a worker that
         cannot start rather than a build that breaks. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove"/>
    <!-- And the one androidx core generates for itself, which only
         ContextCompat.registerReceiver ever holds: measured on the release APK,
         that method is called zero times (all seven registerReceiver calls go
         straight to the platform Context), and the permission name is not in the
         dex at all. It is signature level, so nothing but this app could ever
         have been granted it, but F-Droid prints it in the listing all the same
         and a name like that invites a question nobody should have to ask.

         This is the more debatable of the two removals, so the risk is written
         down: a future dependency reaching for ContextCompat.registerReceiver
         would find the permission gone. Dropping these two lines puts it back.
         The <permission> element goes with it: declaring a permission nothing
         uses is the same claim in a quieter place. -->
    <uses-permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove"/>
    <permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove"/>
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="${appIcon}">
        <!-- And WorkManager must not start, which is the other half of taking its
             permissions away. androidx.startup runs WorkManagerInitializer in every
             process at launch, and its ForceStopRunnable takes a PowerManager wake
             lock straight away: without WAKE_LOCK that is a SecurityException on the
             startup path, so removing the permission while leaving the initializer
             standing would trade a cosmetic line for a crash. Nothing here schedules
             work (see above), so the honest arrangement is that the library is
             present but never initialized. androidx documents exactly this node as
             the way to switch to on-demand initialization.

             What it costs is named: a later HomeWidget.registerInteractivityCallback
             would fail with "WorkManager is not initialized properly" rather than
             quietly doing nothing, which is the failure worth having. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data android:name="androidx.work.WorkManagerInitializer" tools:node="remove"/>
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- We read shared .tpt file intents ourselves (see MainActivity)
                 and import them via a method channel, so Flutter must not treat
                 the intent's file:// URI as a navigation route. The home-screen
                 widget deep-links through home_widget, not Flutter routing, so
                 disabling this does not affect it. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Open a tapped .tpt trip file. The unknown extension has no
                 registered type, so the OS delivers it as octet-stream. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <!-- Receive a trip shared from Pappus via the share sheet.
                 Uses the app's own vendor MIME type so only its trips match. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/x-pappus-trip"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Home-screen widget -->
        <receiver
            android:name=".PappusWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pappus_widget_info" />
        </receiver>

        <!-- Serves the scrollable "today's plan" list inside the widget. -->
        <service
            android:name=".TodayItemsRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
